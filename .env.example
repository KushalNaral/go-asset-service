PORT=:8080

# Where originals come from. With ORIGIN_URL set the service is a caching proxy;
# without it, files are read from BASE_PATH on disk.
ORIGIN_URL=http://ecommerce_nginx/storage
# ORIGIN_HOST=newmadanfurnishers.com   # Host header for the origin, if it needs one
ORIGIN_TIMEOUT=15s
# BASE_PATH=/storage

# Memory cache
CACHE_SIZE=5000          # max entries (originals + resized copies + remembered 404s)
CACHE_MEMORY_MB=512      # max memory for cached bodies
MAX_OBJECT_MB=20         # bigger files (videos) are streamed, never cached
CACHE_TTL=24h            # fresh for this long, then revalidated with the origin (If-None-Match)
NEGATIVE_TTL=1m          # how long a missing file is remembered
STALE_IF_ERROR=24h       # serve an expired copy this long while the origin is down
BROWSER_MAX_AGE=168h     # Cache-Control max-age sent to browsers

# Admin API used by the dashboard (Image cache page). Empty = off.
# Use the same value as ASSET_SERVICE_ADMIN_KEY in the API's .env.
ADMIN_KEY=change-me

# Keep hit counts across restarts
STATS_FILE=/data/stats.json

# Trust X-Real-IP / X-Forwarded-For from nginx
TRUST_PROXY=true
